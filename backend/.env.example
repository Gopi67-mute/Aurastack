# MongoDB Atlas connection string (Database > Connect > Drivers). Secret.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=aurastack

# Clerk Dashboard > your app > API Keys. Issuer is derived from your instance
# domain (decode EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY from the frontend .env,
# base64, to confirm it). Not secret, but backend-only.
CLERK_JWT_ISSUER=https://maximum-marlin-5275.clerk.accounts.dev

# Clerk Dashboard > API Keys > Secret keys. Not used for token verification
# (that's done locally via CLERK_JWT_ISSUER's JWKS endpoint) but reserved for
# Phase 3.2 Clerk Backend API calls. Secret.
CLERK_SECRET_KEY=sk_test_key_replace_me

# Leave empty unless you configure a custom Clerk JWT template with an
# audience claim.
JWT_AUDIENCE=

ENVIRONMENT=development
